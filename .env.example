# Credentials definition for local dev
OPENAI_API_KEY=""

DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_KEY=""

EVO_URL=""
EVO_INSTANCE=""
EVO_APIKEY=""
GLOBAL_EVO_APIKEY=""

# Public URL of this app (used to configure Evolution API webhook)
VITE_APP_URL=""

# Integração Bling (API v3 OAuth2) — sync de produtos/imagens pro catálogo
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
# Deve bater EXATAMENTE com a URL de redirecionamento cadastrada no app do Bling
BLING_REDIRECT_URI="https://winassistente.vercel.app/api/bling/callback"

# Integração WinThor (TOTVS) — teste da API de Estoque (stock-vtex)
# BASE_URL: começo do endereço. Ex.: túnel ngrok https://xxx.ngrok-free.app
#           (ou http://10.0.1.3:8069 se a máquina estiver na rede da WIN)
WINTHOR_BASE_URL=""
WINTHOR_USER=""
# Senha do WTA em texto puro — o token MD5 (maiúsculo) é gerado pelo script
WINTHOR_PASS=""
WINTHOR_BRANCH_ID="1"
# 'W' = e-commerce (exige produto com Enviar p/ E-commerce=SIM); 'WSH' = ignora a restrição
WINTHOR_CALL_ORIGIN="W"

# Auth do painel (Fase 1a)
# JWT_SECRET: gere com `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=""
# Email e senha do admin inicial — só usados se NÃO existir nenhum usuário
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
